# Civic Strategy Partners — environment variables
#
# Copy to .env.local for local development and fill in real values.
# Never commit real keys. Production values live in the Vercel project
# (civic-strategy-partners-llc) under Settings → Environment Variables.

# ── Cloudflare Turnstile (contact form bot gate) ──────────────────────────────
# Dashboard: https://dash.cloudflare.com → Turnstile → the civicstrategypartners.com widget.
#
# Public site key. Inlined into the client bundle at build time, so a change
# here requires a rebuild — editing it in Vercel alone will not update an
# existing deployment. Leave unset locally to render the form without the
# widget; the honeypot and rate limit still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secret used for siteverify. Mark as Sensitive in Vercel.
# When unset, the API route logs an error and falls back to honeypot +
# rate limiting rather than rejecting every submission.
TURNSTILE_SECRET_KEY=
